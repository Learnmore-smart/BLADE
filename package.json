{
  "name": "blade",
  "version": "1.0.0",
  "description": "Bypass LLM Agent Defense Engine — adaptive de-hardening of bla-agents protected artifacts so analyzers (REA, decompilers, LLM recon pipelines) see real logic instead of decoys",
  "main": "src/index.mjs",
  "exports": {
    ".": {
      "types": "./src/index.d.mts",
      "default": "./src/index.mjs"
    },
    "./cli": "./src/cli.mjs"
  },
  "bin": {
    "blade": "src/cli.mjs"
  },
  "scripts": {
    "test": "node scripts/verify.mjs",
    "test:robustness": "node scripts/robustness.mjs",
    "test:all": "node scripts/verify-all.mjs",
    "test:detect": "node scripts/test-detect.mjs",
    "test:unit": "node scripts/test-anomaly.mjs && node scripts/test-evaluator.mjs && node scripts/test-name-recovery.mjs && node scripts/test-precision.mjs && node scripts/test-canonical.mjs && node scripts/test-manifest.mjs && node scripts/test-salvage.mjs && node scripts/test-gates.mjs && node scripts/test-sidecar.mjs && node scripts/test-fuses.mjs",
    "test:fuzz": "node scripts/fuzz-js.mjs",
    "fixtures": "node scripts/make-fixtures.mjs",
    "blade": "node src/cli.mjs",
    "test:asar": "node test-fixtures/adversarial/asar/run.mjs",
    "test:beam": "node test-fixtures/adversarial/beam/run.mjs",
    "test:bunfs": "node test-fixtures/adversarial/bunfs/run.mjs",
    "test:dex": "node test-fixtures/adversarial/dex/run-adversarial.mjs",
    "test:dotnet": "node test-fixtures/adversarial/dotnet/run-adversarial.mjs",
    "test:evm": "node test-fixtures/adversarial/evm/run.mjs",
    "test:html": "node test-fixtures/adversarial/html/run-all.mjs",
    "test:js": "node test-fixtures/adversarial/js/run-adversarial.mjs",
    "test:js-324": "node test-fixtures/adversarial/js/v324/run.mjs",
    "test:jvm": "node test-fixtures/adversarial/jvm/adversarial-jvm.mjs",
    "test:native": "node test-fixtures/adversarial/native/check.mjs",
    "test:native-fuses": "node test-fixtures/adversarial/native/check-fuses.mjs",
    "test:native-enclave": "node test-fixtures/adversarial/native/check-enclave.mjs",
    "test:pcap": "node test-fixtures/adversarial/pcap/run-tests.mjs",
    "test:plist": "node test-fixtures/adversarial/plist/run-tests.mjs",
    "test:py": "node test-fixtures/adversarial/py/run.mjs",
    "test:sqlite": "node test-fixtures/adversarial/sqlite/adversarial-sqlite.mjs",
    "test:uf2": "node test-fixtures/adversarial/uf2/run-tests.mjs",
    "test:wasm": "node test-fixtures/adversarial/wasm/run-adversarial.mjs",
    "test:zip": "node test-fixtures/adversarial/zip/run-adversarial.mjs",
    "test:intensity": "node test-fixtures/adversarial/intensity/run.mjs",
    "test:live": "node scripts/live-matrix.mjs"
  },
  "keywords": [
    "reverse-engineering",
    "deobfuscation",
    "dehardening",
    "security",
    "binary-analysis",
    "bla",
    "rea",
    "electron",
    "wasm",
    "static-analysis"
  ],
  "author": "BLADE contributors",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Learnmore-smart/BLADE.git"
  },
  "bugs": "https://github.com/Learnmore-smart/BLADE/issues",
  "homepage": "https://github.com/Learnmore-smart/BLADE#readme",
  "files": [
    "src/",
    "docs/assets/",
    "README.md",
    "LICENSE",
    "CHANGELOG.md",
    "REPORT.md"
  ],
  "type": "commonjs",
  "engines": {
    "node": "^22.23.4 || >=24.0.0"
  },
  "dependencies": {
    "@babel/generator": "^8.1.0",
    "@babel/parser": "^8.1.0",
    "@babel/traverse": "^8.1.0",
    "@babel/types": "^8.1.0"
  }
}
